# ============================================================
# Tirumala Hills Landslide Digital Twin — Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# --- Copernicus Data Space Ecosystem (CDSE) ---
# Register at https://dataspace.copernicus.eu/
CDSE_USERNAME=your_email@example.com
CDSE_PASSWORD=your_password

# --- NASA Earthdata Login ---
# Register at https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_earthdata_user
EARTHDATA_PASSWORD=your_earthdata_password

# --- Gemini project Q&A (Optional) ---
GEMINI_API_KEY=

# --- ASF HyP3 (Alaska Satellite Facility) ---
# Uses NASA Earthdata credentials
# HyP3 API endpoint: https://hyp3-api.asf.alaska.edu

# --- Background monitoring ---
# Pipeline discovery and retry interval (hours; default 6)
MONITORING_INTERVAL_HOURS=6

# --- Telegram Alert Notifications (Optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email Alert Notifications (Optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Database ---
# SQLite path (relative to project root or absolute)
DATABASE_PATH=database/monitoring.db
